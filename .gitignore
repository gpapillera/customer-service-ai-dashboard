# Build output
bin/
obj/
*.user
*.suo
.vs/

# .NET user secrets / local dev settings (may contain secrets)
appsettings.Development.json
secrets.json

# Node / Angular
node_modules/
dist/
.angular/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Python
__pycache__/
*.pyc
.venv/
venv/
env/
ml/data/cleaned/
ml/data/raw/*.output.csv
ml/models/
*.onnx
!ml/models/.gitkeep

# Environment files (secrets)
.env
.env.local
*.local

# IDE / OS
.idea/
.vscode/*
!.vscode/extensions.json
.DS_Store
Thumbs.db

# FUSE mount transient inodes (.fuse_hidden* = deleted-but-open file placeholders on
# the Crucial MX500 USB FUSE mount; they vanish on their own and must never be force-deleted
# or committed — gitignore them so they stay out of `git status`)
.fuse_hidden*

# Logs
*.log
logs/

# SQLite runtime DB (generated at startup via Database:Provider=Sqlite)
*.db
*.db-shm
*.db-wal

# Hermes agent working dir (plans, session logs, skills) — not project code
.hermes/
